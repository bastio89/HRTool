NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
OLLAMA_BASE_URL=http://localhost:11434
ENABLE_PARSE_LATENCY_AGGREGATION=false
PARSE_LATENCY_WINDOW_SIZE=200
PARSE_LATENCY_LOG_EVERY=20
APIFY_TOKEN=your_apify_token
APIFY_LINKEDIN_MCP_COMMAND="npx -y @apify/actors-mcp-server --actors curious_coder/linkedin-profile-scraper"
APIFY_LINKEDIN_MCP_SEARCH_TOOL_NAME=search_profiles

# Must match GRAPHRAG_API_KEY in the backend's environment.
GRAPHRAG_API_KEY=
