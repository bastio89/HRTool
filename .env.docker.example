# Copy to .env before running docker compose.
JWT_SECRET=bitte-durch-einen-mindestens-32-zeichen-langen-zufallswert-ersetzen
EXTERNAL_API_KEY=

# PostgreSQL credentials. Keep these values in sync with DATABASE_URL.
POSTGRES_DB=hrtool
POSTGRES_USER=hrtool
POSTGRES_PASSWORD=bitte-durch-ein-sicheres-passwort-ersetzen
DATABASE_URL=postgresql://hrtool:bitte-durch-ein-sicheres-passwort-ersetzen@postgres:5432/hrtool

# On macOS/Windows Docker Desktop this reaches Ollama running on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_CHAT_MODEL=qwen3.6:35b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# Optional n8n integration running on the host.
N8N_BASE_URL=http://host.docker.internal:5678
N8N_API_KEY=
GRAPHRAG_BASE_URL=http://graphrag:8000

# Neo4j for graphrag. Use a strong password and keep it in sync with the Graphrag .env.
NEO4J_PASSWORD=bitte-durch-ein-sicheres-neo4j-passwort-ersetzen
NEO4J_USER=neo4j

FRONTEND_PORT=5173
BACKEND_PORT=3001
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
GRAPHRAG_PORT=8000
JOB_SQLITE_PATH=/app/data/graphrag_jobs.db

# Caddy: auf die öffentliche DNS-Adresse der Anwendung setzen.
# Für lokale Entwicklung bleibt localhost aktiv (lokales Zertifikat).
APP_DOMAIN=localhost
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Optional administration UI.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=bitte-durch-ein-sicheres-passwort-ersetzen
PGADMIN_PORT=5050
