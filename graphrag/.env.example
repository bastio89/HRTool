NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key
AI_CHAT_MODEL=openai/gpt-4o-mini
AI_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.6:35b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_ENABLE_REASONING=true
ENABLE_PARSE_LATENCY_AGGREGATION=false
PARSE_LATENCY_WINDOW_SIZE=200
PARSE_LATENCY_LOG_EVERY=20
